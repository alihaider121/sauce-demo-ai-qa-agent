# Only needed when running the agent on YOUR laptop.
# In GitHub Actions the built-in GITHUB_TOKEN is used automatically — no secret needed.
#
# Create a fine-grained personal access token at
#   https://github.com/settings/personal-access-tokens
# with the "Models: read" permission (no repository access needed),
# then copy this file to .env and paste the token below.
GITHUB_TOKEN=

# Optional: which free GitHub Models model to use
MODEL=openai/gpt-4o-mini

# Optional: use any other OpenAI-compatible provider instead of GitHub Models.
# Set MODEL above to that provider's model names too; list several (comma-separated)
# so a busy or rate-limited model hands over to the next one.
# e.g. Google Gemini (free tier, ~20 requests per model per day):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   MODEL=gemini-3.7-flash,gemini-3.6-flash,gemini-3.8-flash
LLM_BASE_URL=
LLM_API_KEY=

# Optional: use a browser already installed on this machine instead of
# Playwright's own Chromium download (e.g. msedge or chrome). Leave empty in CI.
PW_CHANNEL=
